# Cluster-specific settings, sourced by the shell scripts and parsed by harness/grids.py and the Makefile
# so every line stays KEY=VALUE, optionally double-quoted, with no shell expansion
SITE_NODE=j21n14                                      # Slurm node name
SITE_PARTITION=tutti                                  # Slurm partition
SITE_MODULES="nvhpc/25.9"                             # environment modules to load on the node (empty for none)
SITE_SLURM_PATH=/opt/slurm/bin                        # where sbatch and scontrol live when not on PATH (empty for none)
SITE_SBATCH_FLAGS="--exclusive --mem=0 --gres=gpu:1"  # how this cluster grants the whole node and one GPU
SITE_BUILD_TIME=00:20:00                              # time limit of a build job
SITE_PHASE_TIME=03:55:00                              # time limit of a phase job (the cluster's maximum minus a margin)
SITE_GATE_FACTOR=2                                    # GPU reads of GPU memory must beat GPU reads of CPU memory by this factor
SITE_SMMU_PMU=smmuv3_pmcg_16002                       # perf PMU of the GPU's SMMU (see /sys/bus/event_source/devices/)
SITE_NCU=/opt/nvidia/hpc_sdk/Linux_aarch64/25.9/profilers/13.0/Nsight_Compute/ncu   # Nsight Compute 2025.3 of the HPC SDK (the CUDA 12 one under /usr/local fails under the 580 driver)
